# API key for the OpenAI-compatible endpoint, e.g. from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-REPLACE_ME

# OpenAI-compatible NIM endpoint. Hosted by default; point it to http://localhost:8000/v1 for a self-hosted NIM.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model roles. Run `c2n models` to see which IDs your key can use.
# Reasoning model: drafting and revising the note
C2N_MODEL_REASONING=nvidia/nemotron-3-super-120b-a12b
# Fast model: extraction, grounding judge, speaker labelling, trial criteria
C2N_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
# Turn Nemotron's thinking mode on for the reasoning model (slower, sometimes better)
C2N_THINKING=false
C2N_TEMPERATURE=0.2
# Default output token limit per call
C2N_MAX_TOKENS=4096

# Speech recognition (Parakeet via Riva). Hosted endpoint on NVIDIA Cloud Functions:
C2N_ASR_SERVER=grpc.nvcf.nvidia.com:443
C2N_ASR_USE_SSL=true
# parakeet-ctc-1.1b-asr (English). Multilingual parakeet-1.1b-rnnt: 71203149-d3b7-4460-8231-1be2543a1fca
C2N_ASR_FUNCTION_ID=1598d209-5e27-4d3c-8079-4751568b1081
C2N_ASR_LANGUAGE=en-US
# For a self-hosted Parakeet NIM use: C2N_ASR_SERVER=localhost:50051, C2N_ASR_USE_SSL=false, C2N_ASR_FUNCTION_ID=
